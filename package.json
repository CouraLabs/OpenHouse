{
  "name": "openhouse",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "deploy": "npm run db:migrate:remote --workspace=api && cd apps/api && wrangler deploy",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "npm run db:generate --workspace=@workspace/db",
    "db:migrate": "npm run db:migrate:local --workspace=api",
    "reset-code": "npm run reset-code --workspace=api --",
    "set-tier": "npm run set-tier --workspace=api --"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "~6.0.2",
    "playwright": "^1.64.1"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true,
    "workerd@1.20261023.1": true,
    "esbuild@0.28.1": true
  }
}
