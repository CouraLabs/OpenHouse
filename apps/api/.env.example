# Environment of the API. Copy this file to `.env` and adjust it.
#
# Every variable is optional here: `src/env.ts` declares what each one must
# look like and which ones a production deployment must set.

NODE_ENV=development
PORT=3000

# Origins allowed to call the API from a browser, comma-separated. Required
# when NODE_ENV is production. Development leaves it unset: the Vite dev server
# proxies to the API, so no browser request is cross-origin.
# CORS_ORIGINS=http://localhost:5173

# Rate limit applied to every route when NODE_ENV is production: at most
# THROTTLE_LIMIT requests per IP per THROTTLE_TTL_MS milliseconds. Sign-in and
# sign-up are limited further, to 10 attempts per minute.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# How many reverse proxies (load balancer, ingress) sit in front of the API.
# Set it behind a proxy so the rate limit counts each client's address rather
# than the proxy's; leave it unset when clients connect directly.
# APP_TRUST_PROXY_HOPS=1

# The secret the session JWTs are signed with. Required when NODE_ENV is
# production; development signs with a fixed local value instead.
# JWT_SECRET=

# Session lifetimes, in seconds. The access token is short by design; the
# refresh token outlives it, and a remembered session (the sign-in's "remember
# me") gets JWT_REMEMBER_REFRESH_TTL_S instead of JWT_REFRESH_TTL_S.
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=86400
JWT_REMEMBER_REFRESH_TTL_S=2592000

# Where the full-data export ZIPs wait for their download (deleted after 24
# hours or the first download). Unset, a folder under the OS temp directory.
# The API process owns it: a second replica would need shared storage.
# EXPORT_DIR=/var/tmp/openhouse-exports

# Web push (due-date reminders to a subscribed browser). Set BOTH keys to enable
# it, or neither to leave push off; one alone stops the boot. Generate a pair
# with `npx web-push generate-vapid-keys`. The subject is a mailto: or https:
# contact the push services can reach.
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:you@example.com
