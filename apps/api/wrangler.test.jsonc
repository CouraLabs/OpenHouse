// The bindings the e2e tests run under (the pool builds a local Miniflare
// from this file): the same bindings as wrangler.jsonc, without the static
// assets (no web build in a test run) and with fixed test secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kantim-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kantim-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "kantim-jobs-test" }]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 100000, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_CREDENTIALS",
      "namespace_id": "2002",
      "simple": { "limit": 100000, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_EMAIL",
      "namespace_id": "2003",
      "simple": { "limit": 100000, "period": 60 }
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "KANTIM_ENABLE_EMAIL_VERIFICATION": "true",
    "KANTIM_ENABLE_CAPTCHA_CHECK": "true",
    "TURNSTILE_SECRET": "test-turnstile-secret",
    "TURNSTILE_SITE_KEY": "test-turnstile-site-key",
    "TURNSTILE_HOSTNAMES": "localhost",
    "APP_URL": "http://localhost/app",
    "JWT_SECRET": "test-secret",
    "JWT_ACCESS_TTL_S": "900",
    "JWT_REFRESH_TTL_S": "86400",
    "JWT_REMEMBER_REFRESH_TTL_S": "2592000"
  }
}
