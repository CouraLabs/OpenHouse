{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var ENVIRONMENT:development",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "biome lint .",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate --workspace=@workspace/db",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "reset-code": "node scripts/reset-code.mjs"
  },
  "dependencies": {
    "@workspace/db": "*",
    "@workspace/poco": "*",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "wrangler": "^4.156.0"
  }
}
