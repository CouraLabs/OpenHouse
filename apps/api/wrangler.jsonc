{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openhouse",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The web app ships from the same Worker: static assets with SPA fallback,
  // and every /api/* request runs the Worker first (sessions, JSON).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // Both the API and the mounted app prefix must run the Worker first:
    // /api/* is Hono, /app/* gets the prefix stripped before the assets
    // binding resolves it (the landing Worker owns the domain root).
    "run_worker_first": ["/api/*", "/app/*"],
    "not_found_handling": "single-page-application"
  },
  // One database for the whole app; every tenant's rows carry tenant_id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openhouse",
      "database_id": "db289b16-8ae4-4970-9728-3b632623eb53",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  // The background jobs fan out per tenant: the cron handler enqueues, the
  // consumer runs the per-tenant service. At-least-once — every job is
  // idempotent.
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "openhouse-jobs" }],
    "consumers": [
      {
        "queue": "openhouse-jobs",
        "max_batch_size": 10,
        "max_retries": 3,
        "max_batch_timeout": 5
      }
    ]
  },
  // Three rate-limit namespaces: the general one for every route, the
  // credential one (tighter) for sign-in, sign-up and password resets, and
  // the email one (tightest) for every route that sends mail: sign-up and
  // confirmation resends. Each user also has a resend cooldown and a daily
  // cap kept in D1.
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_CREDENTIALS",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_EMAIL",
      "namespace_id": "1003",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  // Transactional mail (email confirmation) through Cloudflare Email
  // Sending; couralabs.dev must be onboarded for sending. `wrangler dev`
  // simulates the binding locally and writes the message to disk.
  "send_email": [{ "name": "EMAIL" }],
  "triggers": {
    // Hourly: tenant deletions at :15, recurring rules at :30, reminders at
    // :45 — each tenant's own calendar day decides what is due. Daily at
    // 03:15: the balance-consistency check.
    "crons": ["15 * * * *", "30 * * * *", "45 * * * *", "15 3 * * *"]
  },
  // The app worker serves the domain's /api and /app; the landing Worker
  // takes the rest of the zone (most-specific route wins). Requires the
  // couralabs.dev zone in this Cloudflare account.
  "routes": [
    { "pattern": "openhouse.couralabs.dev/api*", "zone_name": "couralabs.dev" },
    { "pattern": "openhouse.couralabs.dev/app*", "zone_name": "couralabs.dev" }
  ],
  // Workers Logs captures the request lines and the jobs' errors.
  "observability": { "enabled": true },
  "vars": {
    // Non-secret defaults; secrets live in .dev.vars / `wrangler secret put`.
    "JWT_ACCESS_TTL_S": "900",
    "JWT_REFRESH_TTL_S": "86400",
    "JWT_REMEMBER_REFRESH_TTL_S": "2592000",
    "PUSH_VAPID_SUBJECT": "mailto:openhouse@couralabs.dev",
    "EMAIL_FROM": "no-reply@couralabs.dev",
    "EMAIL_FROM_NAME": "OpenHouse",
    "APP_URL": "https://openhouse.couralabs.dev/app",
    // The sign-up bot check accepts tokens minted on these hostnames only;
    // the TURNSTILE_SECRET secret turns the check on (unset: no check).
    "TURNSTILE_HOSTNAMES": "openhouse.couralabs.dev"
  }
}
