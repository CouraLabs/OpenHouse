{
  // The landing page is a pure static site (no API), so this Worker serves
  // only its built assets — no "main", no bindings. Deployed separately from
  // the app Worker ("openhouse"), e.g. on its own domain or subdomain.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openhouse-landing",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist",
    // The site is a single page; unknown paths fall back to index.html.
    "not_found_handling": "single-page-application"
  },
  // The landing owns the domain root. A custom domain creates the proxied DNS
  // record and certificate (a plain route does not, so the host never
  // resolved); the app Worker's /api* and /app* routes still win, because a
  // route takes precedence over a custom domain.
  "routes": [{ "pattern": "openhouse.couralabs.dev", "custom_domain": true }]
}
