{
  "name": "@workspace/business",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "dependencies": {
    "@workspace/db": "*",
    "@workspace/domain": "*",
    "@workspace/dto": "*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "1.0.0-rc.4",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2",
    "wrangler": "^4.156.0"
  }
}
