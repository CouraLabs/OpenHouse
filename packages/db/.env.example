# Connection string used by the API at runtime, by `drizzle-kit`, and by any
# script importing `@workspace/db`. Copy this file to `.env` and adjust it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kantim

# Connection pool options (see `getPoolConfig`). `DATABASE_URL` alone is enough
# to start; these tune the pool, so leave them unset unless the deployment
# needs different ones.

# Maximum number of connections this process opens.
DB_POOL_MAX=10

# How long a query waits for a connection before failing, in milliseconds. A
# small value reports an unreachable host instead of hanging.
DB_CONNECTION_TIMEOUT_MS=5000

# How long an idle connection is kept before it is closed, in milliseconds.
DB_IDLE_TIMEOUT_MS=30000
