# Settings of the Docker Compose stack (`docker compose up`). Copy this file
# to `.env` next to `docker-compose.yml`; Compose reads it automatically.
# Each app's own `.env.example` (apps/api, packages/db, apps/landing) covers
# local development instead.

# Signs the session JWTs. Required: the API refuses to start without it.
# Generate one with `openssl rand -base64 48` and keep it stable — changing
# it signs every user out.
JWT_SECRET=

# The origin users open the app at: scheme, host, and port, no trailing
# slash. The API only accepts browser requests from it.
PUBLIC_ORIGIN=http://localhost:8080

# The host port the web app is published on.
WEB_PORT=8080

# The database password. Set it before the first start: PostgreSQL keeps
# the one it was initialized with in its volume.
POSTGRES_PASSWORD=postgres

# Proxies between the client and the API. The bundled nginx counts as 1;
# put a TLS terminator (Caddy, Traefik, a load balancer) in front and it is 2.
APP_TRUST_PROXY_HOPS=1
