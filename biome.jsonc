{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Single lint configuration for every workspace. `turbo run lint` calls
  // `biome lint` in each package; each run resolves this file by walking up.
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/.turbo",
      "!**/*.tsbuildinfo",
      "!package-lock.json"
    ]
  },
  // Biome lints only: Prettier remains the formatter (`turbo run format`).
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    // NestJS DI uses constructor parameter decorators (`@Inject`, `@Param`).
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      // NestJS resolves constructor parameters through `emitDecoratorMetadata`,
      // so a type-only import of an injectable silently breaks DI.
      "includes": ["apps/api/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      // Vendored shadcn/ui output: `shadcn add` regenerates these files, so the
      // rules its generated markup cannot satisfy are off here only.
      "includes": ["packages/ui/src/components/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "noLabelWithoutControl": "off",
            "noRedundantRoles": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "style": {
            "useImportType": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off",
            "noDocumentCookie": "off"
          }
        }
      }
    }
  ]
}
