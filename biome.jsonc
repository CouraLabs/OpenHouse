{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Single lint configuration for every workspace. `turbo run lint` calls
  // `biome lint` in each package; each run resolves this file by walking up.
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/dev-dist",
      "!**/public",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.turbo",
      "!**/.wrangler",
      "!**/.claude",
      "!packages/ui/src/styles/globals.css",
      "!**/*.tsbuildinfo",
      "!package-lock.json"
    ]
  },
  // Biome lints only: Prettier remains the formatter (`turbo run format`).
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    // NestJS DI uses constructor parameter decorators (`@Inject`, `@Param`).
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    // The layer graph in CLAUDE.md, enforced: each package may import only the
    // packages below it. One override per file set, because a later override
    // replaces the noRestrictedImports options of an earlier one.
    {
      "includes": [
        "apps/web/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/db",
                      "@workspace/db/**",
                      "@workspace/domain",
                      "@workspace/domain/**",
                      "@workspace/business",
                      "@workspace/business/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "hono",
                      "hono/**"
                    ],
                    "message": "Layers (CLAUDE.md): apps/web imports only @workspace/dto and @workspace/ui."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/api/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/db",
                      "@workspace/db/**",
                      "@workspace/domain",
                      "@workspace/domain/**",
                      "drizzle-orm",
                      "drizzle-orm/**"
                    ],
                    "message": "Layers (CLAUDE.md): apps/api imports only @workspace/business and @workspace/dto."
                  },
                  {
                    "group": [
                      "@workspace/business/testing"
                    ],
                    "message": "Layers (CLAUDE.md): @workspace/business/testing is for apps/api/test only."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/api/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/db",
                      "@workspace/db/**",
                      "@workspace/domain",
                      "@workspace/domain/**",
                      "drizzle-orm",
                      "drizzle-orm/**"
                    ],
                    "message": "Layers (CLAUDE.md): apps/api imports only @workspace/business and @workspace/dto."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/business/src/**",
        "!packages/business/src/**/*.spec.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/ui",
                      "@workspace/ui/**"
                    ],
                    "message": "Layers (CLAUDE.md): business imports only @workspace/db, @workspace/domain and @workspace/dto."
                  },
                  {
                    "group": [
                      "hono",
                      "hono/**",
                      "cloudflare:*"
                    ],
                    "message": "Layers (CLAUDE.md): business has no platform code: take values and ports through createBusiness."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/business/src/**/*.spec.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/ui",
                      "@workspace/ui/**"
                    ],
                    "message": "Layers (CLAUDE.md): business imports only @workspace/db, @workspace/domain and @workspace/dto."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/db/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/dto",
                      "@workspace/dto/**",
                      "@workspace/business",
                      "@workspace/business/**",
                      "@workspace/ui",
                      "@workspace/ui/**",
                      "zod",
                      "zod/**"
                    ],
                    "message": "Layers (CLAUDE.md): db imports only @workspace/domain and drizzle-orm."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/dto/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/db",
                      "@workspace/db/**",
                      "@workspace/business",
                      "@workspace/business/**",
                      "@workspace/ui",
                      "@workspace/ui/**",
                      "drizzle-orm",
                      "drizzle-orm/**"
                    ],
                    "message": "Layers (CLAUDE.md): dto imports only @workspace/domain and zod."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/domain/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/db",
                      "@workspace/db/**",
                      "@workspace/dto",
                      "@workspace/dto/**",
                      "@workspace/business",
                      "@workspace/business/**",
                      "@workspace/ui",
                      "@workspace/ui/**",
                      "zod",
                      "zod/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "hono",
                      "hono/**"
                    ],
                    "message": "Layers (CLAUDE.md): domain imports nothing from the repo and has no zod, drizzle or hono."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@workspace/db",
                      "@workspace/db/**",
                      "@workspace/domain",
                      "@workspace/domain/**",
                      "@workspace/dto",
                      "@workspace/dto/**",
                      "@workspace/business",
                      "@workspace/business/**"
                    ],
                    "message": "Layers (CLAUDE.md): ui is label-agnostic and imports nothing from the repo."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/features/transactions/day-header.tsx",
        "apps/web/src/features/transactions/transaction-grid.tsx",
        "apps/web/src/features/transactions/transaction-row.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useAriaPropsSupportedByRole": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/statement-imports/import-sample-table.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/e2e/support/test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/sign-up/sign-up-form.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      // NestJS resolves constructor parameters through `emitDecoratorMetadata`,
      // so a type-only import of an injectable silently breaks DI.
      "includes": ["apps/api/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      // Vendored shadcn/ui output: `shadcn add` regenerates these files, so the
      // rules its generated markup cannot satisfy are off here only.
      "includes": ["packages/ui/src/components/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "noLabelWithoutControl": "off",
            "noRedundantRoles": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "style": {
            "useImportType": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off",
            "noDocumentCookie": "off"
          }
        }
      }
    }
  ]
}
